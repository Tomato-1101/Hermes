{
  "name": "@hermes/cli",
  "version": "0.0.1",
  "private": true,
  "description": "Headless Flow runner: `hermes run <flow.json>`. Executes a Flow IR through Engine→Provider with no Electron UI.",
  "type": "module",
  "bin": {
    "hermes": "./bin/hermes.mjs"
  },
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run --passWithNoTests",
    "hermes": "node bin/hermes.mjs",
    "clean": "rm -rf dist .turbo *.tsbuildinfo"
  },
  "dependencies": {
    "@hermes/desktop-adapter": "workspace:*",
    "@hermes/engine": "workspace:*",
    "@hermes/excel-provider": "workspace:*",
    "@hermes/ir": "workspace:*",
    "@hermes/web-provider": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.7.0",
    "vite-node": "^2.1.0",
    "vitest": "^2.1.0"
  }
}
